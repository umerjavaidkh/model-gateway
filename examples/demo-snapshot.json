{
  "fleet": {
    "version": 1,
    "deployments": [
      {
        "id": "echo-1",
        "key": "echo-model",
        "provider": "echo",
        "endpoint": "in-process",
        "region": "local",
        "trust_tier": "internal",
        "weight": 100,
        "capabilities": [
          "streaming"
        ]
      },
      {
        "id": "echo-external",
        "key": "external-model",
        "provider": "echo",
        "endpoint": "in-process",
        "region": "cloud",
        "trust_tier": "external",
        "weight": 100,
        "capabilities": [
          "streaming"
        ]
      }
    ],
    "aliases": [
      {
        "name": "fast",
        "targets": [
          "echo-model"
        ]
      },
      {
        "name": "outside",
        "targets": [
          "external-model"
        ]
      }
    ],
    "registry": [
      {
        "name": "secret-scan",
        "version": "1.0.0",
        "port": "guardrail",
        "latency_budget_ms": 5,
        "failure_mode": "closed",
        "execution": "builtin",
        "admission": {
          "suite_version": "0",
          "runner": "operator-declared",
          "evidence_ref": "examples/demo-snapshot.json"
        }
      },
      {
        "name": "injection-heuristics",
        "version": "1.0.0",
        "port": "guardrail",
        "latency_budget_ms": 50,
        "failure_mode": "open",
        "execution": "builtin",
        "admission": {
          "suite_version": "0",
          "runner": "operator-declared",
          "evidence_ref": "examples/demo-snapshot.json"
        }
      }
    ],
    "policy_bundle_ref": "demo",
    "default_guardrails": [
      {
        "component": "secret-scan",
        "timeout_ms": 5,
        "failure_mode": "closed",
        "blocking": true
      },
      {
        "component": "injection-heuristics",
        "timeout_ms": 50,
        "failure_mode": "open",
        "blocking": false
      }
    ],
    "default_policy": {
      "id": "demo",
      "version": 1,
      "default_effect": "allow",
      "rules": [
        {
          "id": "classify-external",
          "effect": "allow",
          "models": [
            "outside"
          ],
          "data_class": "confidential"
        },
        {
          "id": "no-embeddings",
          "effect": "deny",
          "endpoints": [
            "embeddings"
          ],
          "reason": "embeddings are not enabled for this tenant"
        },
        {
          "id": "cap-payload",
          "effect": "deny",
          "max_payload_bytes": 0,
          "models": [
            "oversized"
          ],
          "reason": "model is retired"
        },
        {
          "id": "restrict-fast",
          "effect": "allow",
          "models": [
            "fast"
          ],
          "data_class": "restricted",
          "min_trust_tier": "INTERNAL"
        }
      ]
    }
  },
  "tenants": [
    {
      "id": "demo",
      "tier": "demo",
      "version": 1,
      "key_prefixes": [
        "demo"
      ],
      "min_trust_tier": "external",
      "budgets": [
        {
          "id": "demo-monthly",
          "scope": "ORG",
          "limit_micro_usd": 10000000
        }
      ],
      "keys": [
        {
          "key_id": "demo-key",
          "org": "demo-org",
          "models_allow_all": true,
          "budgets": [
            {
              "id": "demo-monthly",
              "scope": "ORG"
            }
          ],
          "data_class": "internal"
        }
      ]
    }
  ]
}
