# The PII NER sidecar. One per worker, reached over a Unix socket in a volume
# they share — never over the network, because its entire input is unredacted
# personal data.
FROM python:3.12-slim

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

WORKDIR /app
COPY sidecars/pii-ner/pyproject.toml sidecars/pii-ner/uv.lock ./
RUN uv sync --frozen --no-install-project

COPY sidecars/pii-ner/ ./
RUN uv sync --frozen

ENV PATH="/app/.venv/bin:$PATH"
ENV PII_NER_SOCKET=/run/pii/ner.sock

# 65532 to match distroless's "nonroot", which is what the worker runs as.
# A Unix socket needs write permission to connect, and one created under the
# default umask by a different uid gives the worker none — the same lesson the
# admission runner learned in ADR 0010. Owning the mount point in the image
# also makes Docker create the shared volume with this ownership rather than
# root's.
RUN useradd --create-home --uid 65532 --user-group nonroot  && mkdir -p /run/pii  && chown nonroot:nonroot /run/pii
USER nonroot:nonroot

ENTRYPOINT ["pii-ner"]
